# Native experimental authorization path, WITHOUT fixture activation switches.
# The portable harness uses real ownership code and synthetic ELF originals.
MEMORY_EXPERIMENT_SRCS = t_memory_experiment.c $(filter-out t_memory_runtime.c,$(MEMORY_RUNTIME_SRCS)) ../hle_memory_hooks.c
MEMORY_EXPERIMENT_DEPS = $(MEMORY_EXPERIMENT_SRCS) t_memory_runtime_startup.c t_memory_runtime.c ../hle_memory_experiment.c ../hle_memory_experiment.h ../hle_memory_hooks.h $(MEMORY_RUNTIME_DEPS)
MEMORY_EXPERIMENT_FLAGS = $(MAP_MEMORY_FLAGS) -Wno-unused-function -DDM_GAME_ALLOC_BIG_ALIGN=1
$(B)/t_memory_experiment: $(MEMORY_EXPERIMENT_DEPS) | $(B)
	$(CC) $(MEMORY_EXPERIMENT_FLAGS) -DDM_EXPERIMENTAL_SHARED_MEMORY=1 -o $@ $(MEMORY_EXPERIMENT_SRCS)
$(B)/t_memory_experiment_gate: $(MEMORY_EXPERIMENT_DEPS) | $(B)
	$(CC) $(MEMORY_EXPERIMENT_FLAGS) -o $@ $(MEMORY_EXPERIMENT_SRCS)
$(B)/t_memory_experiment_unaligned: $(MEMORY_EXPERIMENT_DEPS) | $(B)
	$(CC) $(MEMORY_EXPERIMENT_FLAGS) -DDM_EXPERIMENTAL_SHARED_MEMORY=1 -DMEMORY_EXPERIMENT_NO_ALIGNED_LEASES -o $@ $(MEMORY_EXPERIMENT_SRCS)
$(B)/t_memory_experiment_16k: $(MEMORY_EXPERIMENT_DEPS) | $(B)
	$(CC) $(MEMORY_EXPERIMENT_FLAGS) -DDM_EXPERIMENTAL_SHARED_MEMORY=1 -DDM_TEST_HOST_PAGE_16K -o $@ $(MEMORY_EXPERIMENT_SRCS)
$(B)/t_memory_experiment_sanitize: $(MEMORY_EXPERIMENT_DEPS) | $(B)
	$(CC) $(MEMORY_EXPERIMENT_FLAGS) -DDM_EXPERIMENTAL_SHARED_MEMORY=1 -fsanitize=address,undefined -fno-omit-frame-pointer -o $@ $(MEMORY_EXPERIMENT_SRCS)
$(B)/t_memory_experiment_16k_sanitize: $(MEMORY_EXPERIMENT_DEPS) | $(B)
	$(CC) $(MEMORY_EXPERIMENT_FLAGS) -DDM_EXPERIMENTAL_SHARED_MEMORY=1 -DDM_TEST_HOST_PAGE_16K -fsanitize=address,undefined -fno-omit-frame-pointer -o $@ $(MEMORY_EXPERIMENT_SRCS)
.PHONY: memory-experiment memory-experiment-sanitize
memory-experiment: $(B)/t_memory_experiment $(B)/t_memory_experiment_gate $(B)/t_memory_experiment_16k $(B)/t_memory_experiment_unaligned
	$(B)/t_memory_experiment
	$(B)/t_memory_experiment_gate
	$(B)/t_memory_experiment_16k
	$(B)/t_memory_experiment_unaligned
