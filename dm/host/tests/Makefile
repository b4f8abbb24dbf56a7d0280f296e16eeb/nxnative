# dm/host unit tests in one command: make -C dm/host/tests GAME=<base game title ID> run (takes seconds; build output goes to build/ and is not committed)
B = build
PYTHON ?= python3
MEMORY_HOOK_SRCS = ../hle_memory_experiment.c ../hle_memory_hooks.c ../hle_standard_allocator_adapter.c ../hle_standard_allocator_core.c ../hle_vamm_adapter.c ../hle_vamm.c
# game profile header (dm.h needs game_profile.h, generated by the host Makefile into ../gen/<profile>/)
# tests that use the game profile need GAME=<base game title ID> (there is no default game); GINC only expands when used, so tests without the profile build as before
GINC = $(if $(strip $(GAME)),-I../gen/$(GAME) -I../../games/$(GAME),$(error GAME is not set: make GAME=<base game title ID>: $(shell python3 ../../games/game.py list | awk -F'\t' '{printf "%s (%s)  ", $$1, $$3}')))
GAME_H = ../gen/$(GAME)/game_profile.h
run: $(B)/t_heap_size $(B)/t_touch $(B)/t_gesture $(B)/t_oe $(B)/t_fs $(B)/t_fs_commit_list $(B)/t_thread_leak $(B)/t_fs_case $(B)/t_audio $(B)/t_audio_spsc $(B)/t_swkbd $(B)/t_altstack $(B)/t_condvar $(B)/t_condvar_old $(B)/t_pctl $(B)/t_time $(B)/t_shared_font $(B)/t_vorbis $(B)/t_vorbis_divides $(B)/t_hid $(B)/t_haptics $(B)/t_haptics_apple
	$(B)/t_heap_size
	$(B)/t_touch
	$(B)/t_gesture
	$(B)/t_oe 2>/dev/null
	$(B)/t_fs 2>/dev/null
	TMPDIR="$(abspath $(B))" $(B)/t_fs_commit_list
	$(B)/t_thread_leak
	TMPDIR="$(abspath $(B))" $(B)/t_fs_case 2>/dev/null
	$(B)/t_audio
	$(B)/t_audio_spsc
	$(B)/t_swkbd
	$(B)/t_altstack
	$(B)/t_condvar
	$(B)/t_condvar_old
	$(B)/t_pctl
	$(B)/t_time
	$(B)/t_shared_font
	$(B)/t_vorbis
	$(B)/t_vorbis_divides
	$(B)/t_hid
	$(B)/t_haptics
	$(B)/t_haptics_apple
	$(B)/t_nro
run: $(B)/t_nro
$(B)/t_nro: t_nro.c $(MEMORY_HOOK_SRCS) ../hle_memory_experiment.h ../loader.c ../hle_ro.c ../hle.h ../dm.h $(GAME_H) | $(B)
	clang -O1 -g -Wall -Wno-unused-function -Wno-deprecated-declarations -I.. $(GINC) -o $@ t_nro.c $(MEMORY_HOOK_SRCS)
.PHONY: nro
nro: $(B)/t_nro
	$(B)/t_nro
$(GAME_H):
	$(MAKE) -C .. game_profile GAME=$(GAME)
# The fail-fast regression uses the synthetic profile and upstream bitmap backend,
# so it covers initialization/accounting without a game header or Apple SDK.
HEAP_SIZE_DEPS = t_heap_size.c address_space_profile/game_profile.h ../hle_svc.c ../hle_vamm_native.h ../hle_vamm.h ../dm.h ../hle_standard_allocator_provider.h ../standard_allocator_core.h
$(B)/t_heap_size: $(HEAP_SIZE_DEPS) | $(B)
	$(CC) $(AS_SVC_FLAGS) -Wno-unused-function -fsanitize=undefined -o $@ t_heap_size.c
$(B)/t_heap_size_sanitize: $(HEAP_SIZE_DEPS) | $(B)
	$(CC) $(AS_SVC_FLAGS) -Wno-unused-function -fsanitize=address,undefined -fno-omit-frame-pointer -o $@ t_heap_size.c
.PHONY: heap_size heap-size-sanitize
heap-size-sanitize: $(B)/t_heap_size_sanitize
	$(B)/t_heap_size_sanitize
heap_size: $(B)/t_heap_size
	$(B)/t_heap_size
$(B)/t_touch: t_touch.c ../hle_touch.c ../front.h ../dm.h $(GAME_H) | $(B)
	clang -O1 -Wno-unused-function -I.. $(GINC) -o $@ t_touch.c ../hle_touch.c
$(B)/t_gesture: t_gesture.c ../hle_touch.c ../front.h ../dm.h $(GAME_H) | $(B)
	clang -O1 -Wall -Wno-unused-function -I.. $(GINC) -o $@ t_gesture.c ../hle_touch.c
$(B)/t_thread_leak: t_thread_leak.c ../thread.c ../dm.h $(GAME_H) | $(B)
	clang -O1 -Wno-unused-function -I.. $(GINC) -o $@ t_thread_leak.c
$(B)/t_fs: t_fs.c t_fs_stub.c ../hle_fs.c ../hle_bigstack.c ../hle.h ../dm.h $(GAME_H) | $(B)
	clang -O1 -Wno-unused-function -I.. $(GINC) -o $@ t_fs.c t_fs_stub.c ../hle_bigstack.c
$(B)/t_fs_commit_list: t_fs_commit_list.c t_fs_stub.c ../hle_fs.c ../hle_bigstack.c ../hle.h ../dm.h $(GAME_H) | $(B)
	clang -O1 -Wall -Wno-unused-function -I.. $(GINC) -o $@ t_fs_commit_list.c t_fs_stub.c ../hle_bigstack.c
$(B)/t_fs_case: t_fs_case.c ../hle_fs.c ../hle_bigstack.c ../hle.h ../dm.h $(GAME_H) | $(B)
	clang -O1 -Wno-unused-function -I.. $(GINC) -o $@ t_fs_case.c ../hle_bigstack.c
$(B)/t_audio: t_audio.c ../hle_audio.c ../hle.h ../dm.h $(GAME_H) | $(B)
	clang -O1 -Wno-unused-function -I.. $(GINC) -o $@ t_audio.c -framework AudioToolbox
$(B)/t_audio_spsc: t_audio_spsc.c ../hle_audio.c ../hle.h ../dm.h $(GAME_H) | $(B)
	clang -O1 -Wno-unused-function -I.. $(GINC) -o $@ t_audio_spsc.c -framework AudioToolbox
$(B)/t_audio_spsc_tsan: t_audio_spsc.c ../hle_audio.c ../hle.h ../dm.h $(GAME_H) | $(B)
	clang -O1 -g -O1 -fsanitize=thread -Wno-unused-function -I.. $(GINC) -o $@ t_audio_spsc.c -framework AudioToolbox
$(B)/t_swkbd: t_swkbd.c ../hle_swkbd.c ../hle.h ../dm.h $(GAME_H) | $(B)
	clang -O1 -Wno-unused-function -I.. $(GINC) -o $@ t_swkbd.c ../hle_swkbd.c
$(B)/t_altstack: t_altstack.c t_altstack_stub.c ../crash.c ../dm.h $(GAME_H) | $(B)
	clang -O1 -Wno-unused-function -I.. $(GINC) -o $@ t_altstack.c t_altstack_stub.c ../crash.c
$(B)/t_pctl: t_pctl.c ../hle_misc.c ../hle.h ../dm.h $(GAME_H) | $(B)
	clang -O1 -Wall -Werror -Wno-unused-function -I.. $(GINC) -o $@ t_pctl.c
$(B)/t_shared_font: t_shared_font.c ../hle_sdk16.c ../hle.h ../dm.h $(GAME_H) | $(B)
	clang -O1 -Wall -Werror -Wno-unused-function -Wno-frame-address -I.. $(GINC) -o $@ t_shared_font.c
$(B)/t_hid: t_hid.c ../hle_hid.c ../hle_haptics.c ../hle_haptics.h ../pad_slots.h ../dm_input.h ../hle.h ../dm.h $(GAME_H) | $(B)
	clang -O1 -Wall -Werror -Wno-unused-function -I.. $(GINC) -o $@ t_hid.c ../hle_haptics.c
$(B)/t_haptics: t_haptics.c ../hle_haptics.c ../hle_haptics.h ../dm_input.h | $(B)
	clang -O1 -g -Wall -Werror -I.. -o $@ t_haptics.c ../hle_haptics.c
$(B)/t_haptics_apple: t_haptics_apple.m ../haptics_apple.m ../haptics_apple.h ../hle_haptics.c ../hle_haptics.h | $(B)
	clang -O1 -g -fobjc-arc -Wall -Werror -I.. -o $@ t_haptics_apple.m ../hle_haptics.c -framework Cocoa -framework GameController -framework CoreHaptics
$(B)/t_time: t_time.c ../hle_time.c ../hle.h ../dm.h $(GAME_H) | $(B)
	clang -O1 -Wall -Werror -Wno-unused-function -I.. $(GINC) -o $@ t_time.c
$(B)/t_oe: t_oe.c ../hle_oe.c ../hle.h ../dm.h $(GAME_H) | $(B)
	clang -O1 -Wno-unused-function -I.. $(GINC) -o $@ t_oe.c
$(B)/t_condvar: t_condvar.c t_condvar_stub.c ../hle_thread.c ../dm.h $(GAME_H) | $(B)
	clang -O1 -Wno-unused-function -DDM_TEST_HOOKS -I.. $(GINC) -o $@ t_condvar.c t_condvar_stub.c ../hle_thread.c
$(B)/t_condvar_old: t_condvar.c t_condvar_stub.c ../hle_thread.c ../dm.h $(GAME_H) | $(B)
	clang -O1 -Wno-unused-function -DDM_TEST_HOOKS -DDM_TEST_CV_OLD_ORDER -I.. $(GINC) -o $@ t_condvar.c t_condvar_stub.c ../hle_thread.c
# the Vorbis tests build their own packets and need no game profile (they build without GAME)
$(B)/t_vorbis: t_vorbis.c ../../third_party/stb_vorbis/stb_vorbis.c | $(B)
	clang -O1 -g -Wno-unused-function -Wno-tautological-compare -o $@ t_vorbis.c
$(B)/t_vorbis_divides: t_vorbis.c ../../third_party/stb_vorbis/stb_vorbis.c | $(B)
	clang -O1 -g -DSTB_VORBIS_DIVIDES_IN_RESIDUE -Wno-unused-function -Wno-tautological-compare -o $@ t_vorbis.c
$(B):
	mkdir -p $@
.PHONY: run tsan
tsan: $(B)/t_audio_spsc_tsan
	$(B)/t_audio_spsc_tsan

MEM_FLAGS = -std=gnu11 -O1 -g -Wall -Werror -Wno-unused-function -Wno-format -pthread -Imemory_profile -I..
GUEST_IMPORT_DEPS = ../guest_mutex_signatures.inc ../guest_thread_binding.h ../guest_thread_imports.h ../guest_thread_imports.generated.inc ../guest_thread_abi.h ../guest_thread_signatures.inc
MEM_DEPS = $(GUEST_IMPORT_DEPS) t_svc_memory.c memory_profile/game_profile.h ../hle_svc.c ../hle_guestthread.c ../hle.h ../dm.h
$(B)/t_svc_memory: $(MEM_DEPS) | $(B)
	$(CC) $(MEM_FLAGS) -fsanitize=undefined -o $@ t_svc_memory.c
$(B)/t_svc_memory_unlimited: $(MEM_DEPS) | $(B)
	$(CC) $(MEM_FLAGS) -fsanitize=undefined -DDM_GAME_MEM_MAP_LIMIT=0 -o $@ t_svc_memory.c
$(B)/t_svc_memory_16k: $(MEM_DEPS) | $(B)
	$(CC) $(MEM_FLAGS) -fsanitize=address,undefined -DTEST_PAGE_16K -o $@ t_svc_memory.c
$(B)/t_svc_memory_tsan: $(MEM_DEPS) | $(B)
	$(CC) $(MEM_FLAGS) -fsanitize=thread -o $@ t_svc_memory.c
$(B)/t_svc_memory_dirty: $(MEM_DEPS) ../../gfx/nvn/nvn_dirty.c ../../gfx/nvn/nvn_dirty.h | $(B)
	$(CC) $(MEM_FLAGS) -DTEST_REAL_DIRTY -o $@ t_svc_memory.c ../../gfx/nvn/nvn_dirty.c
.PHONY: memory memory-tsan memory-dirty memory-profile
memory: $(B)/t_svc_memory $(B)/t_svc_memory_unlimited $(B)/t_svc_memory_16k
	$(B)/t_svc_memory
	$(B)/t_svc_memory_unlimited
	$(B)/t_svc_memory_16k
memory-tsan: $(B)/t_svc_memory_tsan
	$(B)/t_svc_memory_tsan
memory-dirty: $(B)/t_svc_memory_dirty
	$(B)/t_svc_memory_dirty
memory-profile: $(B)/t_svc_memory
	$(PYTHON) test_memory_profile.py
run: memory memory-dirty memory-profile
AS_FLAGS = -std=c11 -O1 -g -Wall -Wextra -Werror -pthread -I..

# Compile the production SVC dispatcher with a tiny synthetic profile and stub
# only unrelated services. Both legacy (unlimited alias maps) and pool-limited
# profiles must retain their accounting policy. Existing Darwin printf formats
# use %llx for uint64_t, so suppress that platform-only warning in this harness.
AS_SVC_FLAGS = $(AS_FLAGS) -std=gnu11 -Wno-format -Iaddress_space_profile
AS_SVC_DEPS = t_address_space_svc.c heap_failure_test.h memory_failure_test.h address_space_profile/game_profile.h ../hle_svc.c ../hle_vamm_native.h ../hle_vamm.h ../dm.h ../hle_standard_allocator_provider.h ../standard_allocator_core.h
$(B)/t_address_space_svc: $(AS_SVC_DEPS) | $(B)
	$(CC) $(AS_SVC_FLAGS) -o $@ t_address_space_svc.c
$(B)/t_address_space_svc_unlimited: $(AS_SVC_DEPS) | $(B)
	$(CC) $(AS_SVC_FLAGS) -DDM_GAME_MEM_MAP_LIMIT=0 -o $@ t_address_space_svc.c
$(B)/t_address_space_svc_sanitize: $(AS_SVC_DEPS) | $(B)
	$(CC) $(AS_SVC_FLAGS) -fsanitize=address,undefined -fno-omit-frame-pointer -o $@ t_address_space_svc.c
$(B)/t_address_space_svc_tsan: $(AS_SVC_DEPS) | $(B)
	$(CC) $(AS_SVC_FLAGS) -fsanitize=thread -fno-omit-frame-pointer -o $@ t_address_space_svc.c
.PHONY: address-space-svc address-space-svc-sanitize address-space-svc-tsan
address-space-svc: $(B)/t_address_space_svc $(B)/t_address_space_svc_unlimited
	$(B)/t_address_space_svc
	$(B)/t_address_space_svc_unlimited
address-space-svc-sanitize: $(B)/t_address_space_svc_sanitize
	$(B)/t_address_space_svc_sanitize
address-space-svc-tsan: $(B)/t_address_space_svc_tsan
	$(B)/t_address_space_svc_tsan
run: address-space-svc

# Logical MapMemory source ownership through the real SVC dispatcher. Simulated
# 16 KiB host pages exercise neighboring 4 KiB source/destination lifetimes on
# Linux as well; this is not a hardware-isolation or Apple-device test.
MAP_MEMORY_FLAGS = -Imap_memory_profile $(AS_SVC_FLAGS)
MAP_MEMORY_DEPS = t_map_memory.c heap_failure_test.h memory_failure_test.h map_memory_profile/game_profile.h address_space_profile/game_profile.h ../hle_svc.c ../hle_vamm_native.h ../hle_vamm.h ../dm.h ../hle_standard_allocator_provider.h ../standard_allocator_core.h
$(B)/t_map_memory: $(MAP_MEMORY_DEPS) | $(B)
	$(CC) $(MAP_MEMORY_FLAGS) -o $@ t_map_memory.c
$(B)/t_map_memory_unlimited: $(MAP_MEMORY_DEPS) | $(B)
	$(CC) $(MAP_MEMORY_FLAGS) -DDM_GAME_MEM_MAP_LIMIT=0 -o $@ t_map_memory.c
$(B)/t_map_memory_16k: $(MAP_MEMORY_DEPS) | $(B)
	$(CC) $(MAP_MEMORY_FLAGS) -DDM_TEST_HOST_PAGE_16K -o $@ t_map_memory.c
$(B)/t_map_memory_16k_unlimited: $(MAP_MEMORY_DEPS) | $(B)
	$(CC) $(MAP_MEMORY_FLAGS) -DDM_TEST_HOST_PAGE_16K -DDM_GAME_MEM_MAP_LIMIT=0 -o $@ t_map_memory.c
$(B)/t_map_memory_sanitize: $(MAP_MEMORY_DEPS) | $(B)
	$(CC) $(MAP_MEMORY_FLAGS) -fsanitize=address,undefined -fno-omit-frame-pointer -o $@ t_map_memory.c
$(B)/t_map_memory_sanitize_unlimited: $(MAP_MEMORY_DEPS) | $(B)
	$(CC) $(MAP_MEMORY_FLAGS) -DDM_GAME_MEM_MAP_LIMIT=0 -fsanitize=address,undefined -fno-omit-frame-pointer -o $@ t_map_memory.c
$(B)/t_map_memory_sanitize_16k: $(MAP_MEMORY_DEPS) | $(B)
	$(CC) $(MAP_MEMORY_FLAGS) -DDM_TEST_HOST_PAGE_16K -fsanitize=address,undefined -fno-omit-frame-pointer -o $@ t_map_memory.c
$(B)/t_map_memory_sanitize_16k_unlimited: $(MAP_MEMORY_DEPS) | $(B)
	$(CC) $(MAP_MEMORY_FLAGS) -DDM_TEST_HOST_PAGE_16K -DDM_GAME_MEM_MAP_LIMIT=0 -fsanitize=address,undefined -fno-omit-frame-pointer -o $@ t_map_memory.c
$(B)/t_map_memory_tsan: $(MAP_MEMORY_DEPS) | $(B)
	$(CC) $(MAP_MEMORY_FLAGS) -fsanitize=thread -fno-omit-frame-pointer -o $@ t_map_memory.c
$(B)/t_map_memory_tsan_unlimited: $(MAP_MEMORY_DEPS) | $(B)
	$(CC) $(MAP_MEMORY_FLAGS) -DDM_GAME_MEM_MAP_LIMIT=0 -fsanitize=thread -fno-omit-frame-pointer -o $@ t_map_memory.c
$(B)/t_map_memory_tsan_16k: $(MAP_MEMORY_DEPS) | $(B)
	$(CC) $(MAP_MEMORY_FLAGS) -DDM_TEST_HOST_PAGE_16K -fsanitize=thread -fno-omit-frame-pointer -o $@ t_map_memory.c
$(B)/t_map_memory_tsan_16k_unlimited: $(MAP_MEMORY_DEPS) | $(B)
	$(CC) $(MAP_MEMORY_FLAGS) -DDM_TEST_HOST_PAGE_16K -DDM_GAME_MEM_MAP_LIMIT=0 -fsanitize=thread -fno-omit-frame-pointer -o $@ t_map_memory.c
.PHONY: map-memory map-memory-sanitize map-memory-tsan
map-memory: $(B)/t_map_memory $(B)/t_map_memory_unlimited $(B)/t_map_memory_16k $(B)/t_map_memory_16k_unlimited
	$(B)/t_map_memory
	$(B)/t_map_memory_unlimited
	$(B)/t_map_memory_16k
	$(B)/t_map_memory_16k_unlimited
map-memory-sanitize: $(B)/t_map_memory_sanitize $(B)/t_map_memory_sanitize_unlimited $(B)/t_map_memory_sanitize_16k $(B)/t_map_memory_sanitize_16k_unlimited
	$(B)/t_map_memory_sanitize
	$(B)/t_map_memory_sanitize_unlimited
	$(B)/t_map_memory_sanitize_16k
	$(B)/t_map_memory_sanitize_16k_unlimited
map-memory-tsan: $(B)/t_map_memory_tsan $(B)/t_map_memory_tsan_unlimited $(B)/t_map_memory_tsan_16k $(B)/t_map_memory_tsan_16k_unlimited
	$(B)/t_map_memory_tsan
	$(B)/t_map_memory_tsan_unlimited
	$(B)/t_map_memory_tsan_16k
	$(B)/t_map_memory_tsan_16k_unlimited
run: map-memory

# Instance-owned StandardAllocator core over a small real synthetic provider.
# No game profile or proprietary SDK binary is read or linked by these tests.
SA_FLAGS = -std=c11 -O1 -g -Wall -Wextra -Werror -pthread -I..
SA_DEPS = t_standard_allocator_core.c ../hle_standard_allocator_core.c ../standard_allocator_core.h
$(B)/t_standard_allocator_core: $(SA_DEPS) | $(B)
	$(CC) $(SA_FLAGS) -o $@ t_standard_allocator_core.c ../hle_standard_allocator_core.c
$(B)/t_standard_allocator_core_sanitize: $(SA_DEPS) | $(B)
	$(CC) $(SA_FLAGS) -fsanitize=address,undefined -fno-omit-frame-pointer -o $@ t_standard_allocator_core.c ../hle_standard_allocator_core.c
$(B)/t_standard_allocator_core_tsan: $(SA_DEPS) | $(B)
	$(CC) $(SA_FLAGS) -fsanitize=thread -fno-omit-frame-pointer -o $@ t_standard_allocator_core.c ../hle_standard_allocator_core.c
.PHONY: standard-allocator standard-allocator-sanitize standard-allocator-tsan
standard-allocator: $(B)/t_standard_allocator_core
	$(B)/t_standard_allocator_core
standard-allocator-sanitize: $(B)/t_standard_allocator_core_sanitize
	$(B)/t_standard_allocator_core_sanitize
standard-allocator-tsan: $(B)/t_standard_allocator_core_tsan
	$(B)/t_standard_allocator_core_tsan
run: standard-allocator

