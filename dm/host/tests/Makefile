# Exercise the same bounded relocation transaction called by loader.c. No game
# header, guest code, Apple SDK, or private inputs are required.
MEMORY_HOOK_FLAGS = $(SA_FLAGS) -Iaddress_space_profile
MEMORY_HOOK_TEST_FLAGS = $(MEMORY_HOOK_FLAGS) -DDM_MEMORY_HOOKS_TESTING -DDM_SA_ADAPTER_TESTING -DDM_VAMM_ADAPTER_TESTING
MEMORY_HOOK_DEPS = ../hle_memory_experiment.h ../hle_memory_runtime.h t_memory_hooks.c $(MEMORY_HOOK_SRCS) ../hle_memory_hooks.h ../dm.h ../hle_standard_allocator_adapter.h ../hle_vamm_adapter.h
$(B)/t_memory_hooks: $(MEMORY_HOOK_DEPS) | $(B)
	$(CC) $(MEMORY_HOOK_TEST_FLAGS) -o $@ t_memory_hooks.c $(MEMORY_HOOK_SRCS)
$(B)/t_memory_hooks_gate: $(MEMORY_HOOK_DEPS) | $(B)
	$(CC) $(MEMORY_HOOK_FLAGS) -o $@ t_memory_hooks.c $(MEMORY_HOOK_SRCS)
$(B)/t_memory_hooks_sanitize: $(MEMORY_HOOK_DEPS) | $(B)
	$(CC) $(MEMORY_HOOK_TEST_FLAGS) -fsanitize=address,undefined -fno-omit-frame-pointer -o $@ t_memory_hooks.c $(MEMORY_HOOK_SRCS)
.PHONY: memory-hooks memory-hooks-sanitize
memory-hooks: $(B)/t_memory_hooks $(B)/t_memory_hooks_gate
	$(B)/t_memory_hooks
	$(B)/t_memory_hooks_gate
memory-hooks-sanitize: $(B)/t_memory_hooks_sanitize
	$(B)/t_memory_hooks_sanitize
run: memory-hooks

# loader.c itself uses Mach-O/CommonCrypto/AArch64 TSD, so this end-to-end wrapper
# fixture joins the existing Apple host run, not the portable Linux target.
MEMORY_HOOK_NATIVE_FLAGS ?= -O1 -g -Wall -Wno-unused-function -Wno-deprecated-declarations
$(B)/t_memory_hooks_loader: t_memory_hooks_loader.c $(MEMORY_HOOK_DEPS) ../loader.c ../hle_count.c $(GAME_H) | $(B)
	clang $(MEMORY_HOOK_NATIVE_FLAGS) -DDM_MEMORY_HOOKS_TESTING -DDM_SA_ADAPTER_TESTING -DDM_VAMM_ADAPTER_TESTING -I.. $(GINC) -o $@ t_memory_hooks_loader.c $(MEMORY_HOOK_SRCS)
.PHONY: memory-hooks-loader
memory-hooks-loader: $(B)/t_memory_hooks_loader
	$(B)/t_memory_hooks_loader
	$(B)/t_memory_hooks_loader $(B)/memory-hooks-count.tsv
	$(B)/t_memory_hooks_loader $(B)/memory-hooks-count-empty.tsv --empty
run: memory-hooks-loader

$(B)/t_memory_hooks_tsan: $(MEMORY_HOOK_DEPS) | $(B)
	$(CC) $(MEMORY_HOOK_TEST_FLAGS) -fsanitize=thread -fno-omit-frame-pointer -o $@ t_memory_hooks.c $(MEMORY_HOOK_SRCS)
.PHONY: memory-hooks-tsan
memory-hooks-tsan: $(B)/t_memory_hooks_tsan
	$(B)/t_memory_hooks_tsan

