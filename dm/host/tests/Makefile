# Checked-in descriptors keep normal host/iOS builds independent of generation.
# CI runs the explicit AArch64 ELF regeneration check and native ABI target.
$(B)/t_guestthread_imports: t_guestthread_imports.c $(GUEST_IMPORT_DEPS) | $(B)
	$(CC) $(AS_FLAGS) -o $@ $<
$(B)/t_guestthread_imports_sanitize: t_guestthread_imports.c $(GUEST_IMPORT_DEPS) | $(B)
	$(CC) $(AS_FLAGS) -fsanitize=address,undefined -fno-omit-frame-pointer -o $@ $<
$(B)/t_guestthread_imports_tsan: t_guestthread_imports.c $(GUEST_IMPORT_DEPS) | $(B)
	$(CC) $(AS_FLAGS) -fsanitize=thread -fno-omit-frame-pointer -o $@ $<
GUEST_ABI_FLAGS ?=
$(B)/t_guestthread_abi_c.o: t_guestthread_abi.c $(GUEST_IMPORT_DEPS) | $(B)
	$(CC) $(AS_FLAGS) $(GUEST_ABI_FLAGS) -c -o $@ $<
$(B)/t_guestthread_abi_cpp.o: t_guestthread_abi.cpp $(GUEST_IMPORT_DEPS) | $(B)
	$(CXX) -std=c++17 -Wall -Wextra -Werror -O1 -g $(GUEST_ABI_FLAGS) -c -o $@ $<
$(B)/t_guestthread_abi: $(B)/t_guestthread_abi_c.o $(B)/t_guestthread_abi_cpp.o
	$(CXX) -pthread -o $@ $^
.PHONY: guest-thread-imports guest-thread-imports-sanitize guest-thread-imports-tsan guest-thread-imports-check guest-thread-abi
guest-thread-imports: $(B)/t_guestthread_imports
	$<
guest-thread-imports-sanitize: $(B)/t_guestthread_imports_sanitize
	$<
guest-thread-imports-tsan: $(B)/t_guestthread_imports_tsan
	$<
guest-thread-imports-check:
	$(PYTHON) ../../tools/generate_guest_thread_imports.py --check
guest-thread-abi: $(B)/t_guestthread_abi
	$<
run: guest-thread-imports guest-thread-abi

